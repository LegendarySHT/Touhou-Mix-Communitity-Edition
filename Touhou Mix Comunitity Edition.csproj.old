<Project Sdk="Godot.NET.Sdk/4.0.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TouhouMixCommunityEdition</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CSharp/**/*.cs" />
    <Compile Include="meltysynth/MeltySynth/src/**/*.cs" />
    <Compile Include="meltysynth/MeltySynth/ProjectInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="meltysynth/Examples/**" />
    <Compile Remove="meltysynth/Workspace/**" />
    <Compile Remove="meltysynth/MeltySynthTest/**" />
  </ItemGroup>
</Project>
